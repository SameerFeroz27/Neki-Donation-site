# Copy to .env.local and adjust. Vite only exposes variables prefixed VITE_.

# Absolute API origin. Leave unset to use the dev proxy (see vite.config.ts)
# or the same origin in production.
# VITE_API_BASE_URL=http://localhost:8000

# Serve development fixtures instead of calling the API. Development only:
# never set this for a build that anyone will mistake for real data.
# See src/api/mockData.ts.
# VITE_USE_MOCK_API=true
