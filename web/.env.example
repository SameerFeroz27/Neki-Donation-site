# Copy to .env.local and adjust. Vite only exposes variables prefixed VITE_.

# Absolute API origin. Setting this is all it takes to switch the app from the
# development fixtures to a real API — leave it unset and the fixtures stand in.
# VITE_API_BASE_URL=https://api.example.com

# Force the fixtures on or off, overriding the default above.
#   unset  -> fixtures on when there is no API base URL, off when there is
#   false  -> fixtures off, even with no API configured
# Both are read at BUILD time by vite.config.ts and baked into the bundle, so a
# change needs a rebuild.
# VITE_USE_MOCK_API=true
# VITE_USE_MOCK_API=false
